<mxfile host="Electron" pages="3">
  <diagram id="arch" name="1-架构（单客户端）">
    <mxGraphModel dx="1397" dy="1085" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ai" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" value="AI 客户端&#xa;（MCP）" vertex="1">
          <mxGeometry height="70" width="140" x="40" y="90" as="geometry" />
        </mxCell>
        <mxCell id="app" parent="1" style="swimlane;fillColor=#d5e8d4;strokeColor=#82b366;startSize=30" value="dear-job-seeker 客户端（单进程 Python · 用户本机）" vertex="1">
          <mxGeometry height="800" width="760" x="260" y="40" as="geometry" />
        </mxCell>
        <mxCell id="mcp" parent="app" style="rounded=1;fillColor=#fff;strokeColor=#82b366" value="MCP Server (stdio)&#xa;crawl_start · task_list · jobs_get ｜ login · login_status · logout&#xa;set_frequency · egress_add / egress_remove / egress_list" vertex="1">
          <mxGeometry height="80" width="680" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="q" parent="app" style="rounded=1;fillColor=#fff;strokeColor=#82b366" value="任务队列（进程内 worker 线程）&#xa;claim → run → done / retry / dead&#xa;未登录 → waiting_login" vertex="1">
          <mxGeometry height="90" width="320" x="40" y="170" as="geometry" />
        </mxCell>
        <mxCell id="auth" parent="app" style="rounded=1;fillColor=#fff;strokeColor=#82b366" value="登录管理（login-required provider）&#xa;Playwright 持久化 profile · 扫码&#xa;cookies.json 0600，仅本机" vertex="1">
          <mxGeometry height="90" width="320" x="400" y="170" as="geometry" />
        </mxCell>
        <mxCell id="pubp" parent="app" style="rounded=1;fillColor=#fff;strokeColor=#82b366" value="公开 providers（无 cookie）&#xa;nowcoder · iguopin · chinahr&#xa;list → detail" vertex="1">
          <mxGeometry height="90" width="320" x="40" y="310" as="geometry" />
        </mxCell>
        <mxCell id="bossp" parent="app" style="rounded=1;fillColor=#fff;strokeColor=#82b366" value="登录 providers（带 cookie）&#xa;boss: joblist.json → detail.json&#xa;低频，风控（code≠0）即停" vertex="1">
          <mxGeometry height="90" width="320" x="400" y="310" as="geometry" />
        </mxCell>
        <mxCell id="rate" parent="app" style="rounded=1;fillColor=#fff;strokeColor=#82b366" value="Pacer 频次&#xa;interval + jitter / provider&#xa;可 set_frequency 覆盖" vertex="1">
          <mxGeometry height="80" width="320" x="40" y="450" as="geometry" />
        </mxCell>
        <mxCell id="egress" parent="app" style="rounded=1;fillColor=#fff;strokeColor=#82b366" value="Egress 出口池（IP 配置）&#xa;direct / http 代理 · sticky hash&#xa;冷却 + 健康度；登录 provider 默认 direct" vertex="1">
          <mxGeometry height="80" width="320" x="400" y="450" as="geometry" />
        </mxCell>
        <mxCell id="db" parent="app" style="shape=cylinder3;fillColor=#fff;strokeColor=#82b366;boundedLbl=1" value="SQLite（~/.dear-job-seeker/data.db）&#xa;tasks · jobs · egress · egress_health · provider_settings" vertex="1">
          <mxGeometry height="140" width="380" x="190" y="610" as="geometry" />
        </mxCell>
        <mxCell id="pub" parent="1" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666" value="公开招聘站点" vertex="1">
          <mxGeometry height="50" width="200" x="1100" y="350" as="geometry" />
        </mxCell>
        <mxCell id="boss" parent="1" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666" value="Boss 直聘（需登录态）" vertex="1">
          <mxGeometry height="50" width="200" x="1100" y="530" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="ai" style="endArrow=classic;startArrow=classic;html=1" target="mcp" value="MCP stdio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="mcp" style="endArrow=classic;html=1" target="q">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2b" edge="1" parent="1" source="mcp" style="endArrow=classic;html=1" target="auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="q" style="endArrow=classic;html=1" target="pubp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="q" style="endArrow=classic;html=1" target="bossp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="auth" style="endArrow=classic;html=1" target="bossp" value="cookie">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="pubp" style="endArrow=classic;html=1" target="rate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="bossp" style="endArrow=classic;html=1" target="egress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="rate" style="endArrow=classic;html=1" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="egress" style="endArrow=classic;html=1" target="pub" value="HTTP(S) via 出口">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1060" y="530" />
              <mxPoint x="1060" y="375" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="egress" style="endArrow=classic;html=1" target="boss" value="本机 IP + 个人 cookie">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow" name="2-登录站点抓取时序">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a" value="用户 / AI" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;recursiveResize=0;size=40" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="140" height="700" as="geometry" />
        </mxCell>
        <mxCell id="b" value="MCP + 队列 worker" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;recursiveResize=0;size=40" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="160" height="700" as="geometry" />
        </mxCell>
        <mxCell id="c" value="登录管理 / 浏览器" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;recursiveResize=0;size=40" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="160" height="700" as="geometry" />
        </mxCell>
        <mxCell id="d" value="Boss" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;recursiveResize=0;size=40" vertex="1" parent="1">
          <mxGeometry x="1060" y="40" width="140" height="700" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1 crawl_start(provider=boss, keyword, city)" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="140" as="sourcePoint" />
            <mxPoint x="480" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2 task_id（status=pending）" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="175" as="sourcePoint" />
            <mxPoint x="130" y="175" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="alt" value="alt：无有效 cookie" style="shape=umlFrame;whiteSpace=wrap;html=1;width=130;height=24" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="1180" height="240" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3 检查 cookie → 无效 → task=waiting_login" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="260" as="sourcePoint" />
            <mxPoint x="820" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4 login(boss) → 弹出浏览器扫码" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="320" as="sourcePoint" />
            <mxPoint x="820" y="320" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5 扫码成功 → cookies.json(0600)" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="380" as="sourcePoint" />
            <mxPoint x="1130" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6 登录成功 → waiting_login 任务回 pending，自动续跑" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="430" as="sourcePoint" />
            <mxPoint x="480" y="430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7 joblist.json(page n) → detail.json（带 cookie，Pacer 限速）" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="500" as="sourcePoint" />
            <mxPoint x="1130" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8 jobs[]；code≠0 风控 → 立即停，task=dead/冷却" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1130" y="545" as="sourcePoint" />
            <mxPoint x="480" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9 upsert(provider, source_job_id) → task=done" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="600" as="sourcePoint" />
            <mxPoint x="480" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10 jobs_get(task_id) → 职位 + 详情" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="660" as="sourcePoint" />
            <mxPoint x="480" y="660" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="er" name="3-数据库">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1300" pageHeight="800">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="tasks&#xa;──────────&#xa;id PK&#xa;provider TEXT&#xa;payload JSON {keyword, city, max_pages}&#xa;status pending|running|waiting_login|done|dead&#xa;attempts INT · locked_at · next_run_at&#xa;last_error · stats JSON" style="rounded=0;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="400" height="190" as="geometry" />
        </mxCell>
        <mxCell id="j" value="jobs&#xa;──────────&#xa;id PK · UNIQUE(provider, source_job_id)&#xa;task_id FK（首次发现）&#xa;title, company, city, salary_text, salary_min/max&#xa;description, source_url, published_at&#xa;payload JSON（原始列表项）· detail JSON&#xa;first_seen_at · last_seen_at" style="rounded=0;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="eg" value="egress&#xa;──────────&#xa;id PK（&#39;direct&#39; 或 http://user:pass@host:port）&#xa;provider (&#39;*&#39; 共享 | 专属)&#xa;enabled BOOL" style="rounded=0;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="eh" value="egress_health&#xa;──────────&#xa;PK(egress_id, provider)&#xa;blocked_until · fail_streak&#xa;last_used · total_ok · total_fail" style="rounded=0;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1">
          <mxGeometry x="560" y="330" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ps" value="provider_settings&#xa;──────────&#xa;provider PK&#xa;interval REAL · jitter REAL（覆盖代码默认值）&#xa;max_pages INT" style="rounded=0;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note" value="不入库：cookie（~/.dear-job-seeker/profiles/&lt;provider&gt;/ 0600）&#xa;已删除（相对 v1.0.0）：agents 表、pending_local 状态" style="rounded=0;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="560" y="530" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="1 : N" style="endArrow=ERmany;startArrow=ERone;html=1" edge="1" parent="1" source="t" target="j">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="1 : N" style="endArrow=ERmany;startArrow=ERone;html=1" edge="1" parent="1" source="eg" target="eh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
