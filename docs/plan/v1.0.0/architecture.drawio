<mxfile host="app.diagrams.net">
<diagram id="arch" name="1-架构">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="900"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="ai" value="AI 客户端&#xa;Claude / Cursor" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="1"><mxGeometry x="60" y="75" width="140" height="70" as="geometry"/></mxCell>
<mxCell id="srv" value="服务端 server（Python，docker / 本机均可）" style="swimlane;fillColor=#dae8fc;strokeColor=#6c8ebf;startSize=30" vertex="1" parent="1"><mxGeometry x="260" y="60" width="520" height="760" as="geometry"/></mxCell>
<mxCell id="smcp" value="Server MCP  (Streamable HTTP /mcp)&#xa;create_crawl_task · list_tasks · get_jobs&#xa;set_frequency · set_egress · local_agents" style="rounded=1;fillColor=#fff;strokeColor=#6c8ebf" vertex="1" parent="srv"><mxGeometry x="40" y="50" width="440" height="80" as="geometry"/></mxCell>
<mxCell id="sched" value="Dispatcher&#xa;provider.needs_local ?&#xa;否→ 入 pending；是→ 入 pending_local" style="rounded=1;fillColor=#fff;strokeColor=#6c8ebf" vertex="1" parent="srv"><mxGeometry x="40" y="170" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="rest" value="Local API (REST)&#xa;POST /api/local/claim (long-poll)&#xa;POST /api/local/report&#xa;Bearer AGENT_TOKEN" style="rounded=1;fillColor=#fff;strokeColor=#6c8ebf" vertex="1" parent="srv"><mxGeometry x="280" y="170" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="worker" value="Worker（服务端抓取，无 cookie）&#xa;providers: nowcoder · iguopin · chinahr&#xa;list → detail → upsert" style="rounded=1;fillColor=#fff;strokeColor=#6c8ebf" vertex="1" parent="srv"><mxGeometry x="40" y="310" width="440" height="80" as="geometry"/></mxCell>
<mxCell id="rate" value="Pacer 频次&#xa;interval + jitter&#xa;每 (provider, 出口) 限速" style="rounded=1;fillColor=#fff;strokeColor=#6c8ebf" vertex="1" parent="srv"><mxGeometry x="40" y="440" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="egress" value="Egress 出口池&#xa;direct / http 代理&#xa;sticky hash + 冷却 + 健康度" style="rounded=1;fillColor=#fff;strokeColor=#6c8ebf" vertex="1" parent="srv"><mxGeometry x="280" y="440" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="db" value="SQLite（默认）/ 可换 Postgres&#xa;tasks · jobs · egress · egress_health · agents" style="shape=cylinder3;fillColor=#fff;strokeColor=#6c8ebf;boundedLbl=1" vertex="1" parent="srv"><mxGeometry x="30" y="580" width="220" height="130" as="geometry"/></mxCell>
<mxCell id="loc" value="用户本机 local-mcp（Python）" style="swimlane;fillColor=#d5e8d4;strokeColor=#82b366;startSize=30" vertex="1" parent="1"><mxGeometry x="880" y="60" width="520" height="560" as="geometry"/></mxCell>
<mxCell id="lmcp" value="Local MCP (stdio)&#xa;boss_login · boss_login_status&#xa;boss_search · boss_job_detail · boss_logout" style="rounded=1;fillColor=#fff;strokeColor=#82b366" vertex="1" parent="loc"><mxGeometry x="40" y="50" width="440" height="80" as="geometry"/></mxCell>
<mxCell id="loop" value="Sync loop&#xa;claim → 执行 → report&#xa;（出站连接，穿 NAT）" style="rounded=1;fillColor=#fff;strokeColor=#82b366" vertex="1" parent="loc"><mxGeometry x="40" y="170" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="pw" value="Playwright 持久化 profile&#xa;扫码登录 → cookies.json&#xa;（0600，仅本机，不上报）" style="rounded=1;fillColor=#fff;strokeColor=#82b366" vertex="1" parent="loc"><mxGeometry x="280" y="170" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="bossapi" value="Boss HTTP 抓取（带 cookie）&#xa;joblist.json → detail.json&#xa;低频 + 风控即停" style="rounded=1;fillColor=#fff;strokeColor=#82b366" vertex="1" parent="loc"><mxGeometry x="40" y="310" width="440" height="80" as="geometry"/></mxCell>
<mxCell id="pub" value="公开招聘站点&#xa;nowcoder / iguopin / chinahr" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666" vertex="1" parent="1"><mxGeometry x="400" y="850" width="240" height="40" as="geometry"/></mxCell>
<mxCell id="boss" value="Boss 直聘（需登录态）" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666" vertex="1" parent="1"><mxGeometry x="1000" y="680" width="240" height="50" as="geometry"/></mxCell>
<mxCell id="e1" value="MCP tools" style="endArrow=classic;html=1" edge="1" parent="1" source="ai" target="smcp"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1b" value="MCP stdio（登录/调试）" style="endArrow=classic;html=1;dashed=1" edge="1" parent="1" source="ai" target="lmcp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="30"/><mxPoint x="1120" y="30"/></Array></mxGeometry></mxCell>
<mxCell id="e2" style="endArrow=classic;html=1" edge="1" parent="1" source="smcp" target="sched"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="pending" style="endArrow=classic;html=1" edge="1" parent="1" source="sched" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="pending_local" style="endArrow=classic;html=1" edge="1" parent="1" source="sched" target="rest"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" style="endArrow=classic;html=1" edge="1" parent="1" source="worker" target="rate"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" style="endArrow=classic;html=1" edge="1" parent="1" source="worker" target="egress"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" style="endArrow=classic;html=1" edge="1" parent="1" source="rate" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="HTTP(S) via 出口" style="endArrow=classic;html=1" edge="1" parent="1" source="egress" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="claim / report（HTTPS）" style="endArrow=classic;startArrow=classic;html=1;strokeWidth=2;strokeColor=#b85450" edge="1" parent="1" source="rest" target="loop"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" style="endArrow=classic;html=1" edge="1" parent="1" source="loop" target="bossapi"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="cookie" style="endArrow=classic;html=1" edge="1" parent="1" source="pw" target="bossapi"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="本机 IP + 个人 cookie" style="endArrow=classic;html=1" edge="1" parent="1" source="bossapi" target="boss"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="flow" name="2-本地抓取时序">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="900"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="a" value="用户 / AI" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;recursiveResize=0;size=40" vertex="1" parent="1"><mxGeometry x="60" y="40" width="140" height="780" as="geometry"/></mxCell>
<mxCell id="b" value="Server MCP + 调度" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;recursiveResize=0;size=40" vertex="1" parent="1"><mxGeometry x="360" y="40" width="160" height="780" as="geometry"/></mxCell>
<mxCell id="c" value="local-mcp sync loop" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;recursiveResize=0;size=40" vertex="1" parent="1"><mxGeometry x="680" y="40" width="160" height="780" as="geometry"/></mxCell>
<mxCell id="d" value="Boss（本机+cookie）" style="shape=umlLifeline;perimeter=lifelinePerimeter;container=1;collapsible=0;recursiveResize=0;size=40" vertex="1" parent="1"><mxGeometry x="1000" y="40" width="160" height="780" as="geometry"/></mxCell>
<mxCell id="m1" value="1 create_crawl_task(provider=boss, keyword, city)" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="150" as="sourcePoint"/><mxPoint x="440" y="150" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m2" value="2 needs_local=true → status=pending_local" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="190" as="sourcePoint"/><mxPoint x="130" y="190" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m3" value="3 claim（长轮询，Bearer AGENT_TOKEN）" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="240" as="sourcePoint"/><mxPoint x="440" y="240" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m4" value="4 task{id, keyword, city, max_pages} → running" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="280" as="sourcePoint"/><mxPoint x="760" y="280" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="alt" value="alt：无有效 cookie" style="shape=umlFrame;whiteSpace=wrap;html=1;width=120;height=24" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1160" height="190" as="geometry"/></mxCell>
<mxCell id="m5" value="5 report(status=need_login) → task=waiting_login" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="370" as="sourcePoint"/><mxPoint x="440" y="370" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m6" value="6 boss_login（本机 MCP）→ 弹出浏览器扫码 → 存 cookie" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="430" as="sourcePoint"/><mxPoint x="760" y="430" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m7" value="7 登录成功 → 任务重回 pending_local（loop 自动重 claim）" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="490" as="sourcePoint"/><mxPoint x="440" y="490" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m8" value="8 joblist.json(page n) → detail.json（带 cookie，低频）" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="570" as="sourcePoint"/><mxPoint x="1080" y="570" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m9" value="9 jobs[] / code≠0 风控→ 立即停并上报 blocked" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080" y="610" as="sourcePoint"/><mxPoint x="760" y="610" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m10" value="10 report(jobs[], stats) → upsert(provider, source_job_id) → task=done" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="670" as="sourcePoint"/><mxPoint x="440" y="670" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="m11" value="11 get_jobs(task_id) → 职位+详情" style="html=1;verticalAlign=bottom;endArrow=block" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="730" as="sourcePoint"/><mxPoint x="440" y="730" as="targetPoint"/></mxGeometry></mxCell>
</root></mxGraphModel></diagram>
<diagram id="er" name="3-数据库">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="900"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="tasks&#xa;──────────&#xa;id PK&#xa;provider TEXT&#xa;kind  keyword|tenant&#xa;payload JSON {keyword, city, max_pages}&#xa;status pending|pending_local|running|waiting_login|done|dead&#xa;attempts INT&#xa;locked_at / locked_by&#xa;next_run_at&#xa;last_error&#xa;stats JSON" style="rounded=0;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="60" y="60" width="380" height="230" as="geometry"/></mxCell>
<mxCell id="j" value="jobs&#xa;──────────&#xa;id PK&#xa;UNIQUE(provider, source_job_id)&#xa;task_id FK (首次发现)&#xa;title, company, city, salary_text, salary_min/max&#xa;description, source_url, published_at&#xa;payload JSON（原始列表项）  detail JSON&#xa;collected_by  server|local:&lt;agent&gt;&#xa;first_seen_at / last_seen_at" style="rounded=0;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="560" y="60" width="400" height="230" as="geometry"/></mxCell>
<mxCell id="eg" value="egress&#xa;──────────&#xa;id PK（'direct' 或 http://user:pass@host:port）&#xa;provider ('*' 共享 | 专属)&#xa;enabled BOOL" style="rounded=0;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="60" y="380" width="380" height="120" as="geometry"/></mxCell>
<mxCell id="eh" value="egress_health&#xa;──────────&#xa;PK(egress_id, provider)&#xa;blocked_until, fail_streak&#xa;last_used, total_ok, total_fail" style="rounded=0;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="560" y="380" width="400" height="120" as="geometry"/></mxCell>
<mxCell id="ag" value="agents（本地执行端）&#xa;──────────&#xa;id PK, name&#xa;token_hash（只存哈希）&#xa;providers JSON（如 [boss]）&#xa;last_seen_at, logged_in BOOL&#xa;（cookie 永不上传）" style="rounded=0;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="60" y="580" width="380" height="140" as="geometry"/></mxCell>
<mxCell id="r1" value="1 : N" style="endArrow=ERmany;startArrow=ERone;html=1" edge="1" parent="1" source="t" target="j"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r2" value="1 : N" style="endArrow=ERmany;startArrow=ERone;html=1" edge="1" parent="1" source="eg" target="eh"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="r3" value="locked_by" style="endArrow=ERone;startArrow=ERmany;html=1;dashed=1" edge="1" parent="1" source="t" target="ag"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
</mxfile>
